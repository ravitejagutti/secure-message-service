# Default settings for the API, CLI and UI tests.
#
# These are the PUBLIC demo values matching config/users.example.json (see
# config/README.md). Local testing only. Never put real credentials here:
# set real values as environment variables instead. Any variable you set in
# your environment overrides the value in this file.
#
# Relative paths are relative to the project root.

# Server under test
MSG_URL=https://localhost:8443
MSG_CA_FILE=certs/server.crt
# Seconds to wait for the server to become healthy after starting or restarting it
# (raise it on slow machines)
MSG_SERVER_START_TIMEOUT=60

# Parallel workers for the integration tests (nox -s integration):
# a number (e.g. 4), or "auto" for one worker per CPU core
MSG_TEST_WORKERS=auto

# Retry failed API, CLI and UI tests (never unit tests): true or false, and how many
# extra attempts. Off by default: a test that only passes on a retry is flaky and
# should be fixed, not hidden. Retried attempts are visible in the Allure report.
MSG_TEST_RETRY=false
MSG_TEST_RETRY_COUNT=2

# Demo user (its hashes are in config/users.example.json: keep both in step)
MSG_USER=alice
MSG_PASSWORD=changeme
MSG_TOKEN=pRo1nGR3iigAbgNQbhmWgTHpc-4Yn_TF191Y_u53nZI

# Users file for the server the tests start themselves (read by docker-compose.yml)
USERS_FILE=config/users.example.json

# Files on the host that some tests inspect directly
MSG_DB_PATH=data/messages.db
MSG_AUDIT_LOG=logs/audit.log
